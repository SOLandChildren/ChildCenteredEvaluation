    }
   ],
   "source": [
    "qrels_df = qrels_df.drop_duplicates(subset=[\"qid\", \"docno\"], ignore_index=True, keep=False) # dropping qrels which have multiple relavances for a given (qid, docno) pair\n",
    "len(qrels_df)"
   ]
  },
