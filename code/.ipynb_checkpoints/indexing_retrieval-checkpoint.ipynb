    "from rerank import Rank1Reranker\n",
    "rank_r1 = Rank1Reranker(\"jhu-clsp/rank1-7b\") # reasoning based re-ranker\n",
    "\n",
    "kid_friend_r1 = kid_friend_bm25_cached_retriever >> rank_r1\n",
